generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  PRINCIPAL
  TRANSPORT_STAFF
  SUPER_ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum LoanStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
}

enum FeeFrequency {
  MONTHLY
  TERM
  YEARLY
  ONE_TIME
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_BANKING
}

enum HrAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  ON_LEAVE
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  DROPPED
  EXPELLED
  ALUMNI
}

// Base auth/user record. Each role has a linked profile table for
// role-specific fields, keeping the auth table lean.
model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  email              String   @unique
  phone              String?  @unique
  password           String
  emailVerified      Boolean  @default(false)
  phoneVerified      Boolean  @default(false)
  img                String?
  emailNotifications Boolean  @default(true)
  role               Role
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  admin           Admin?
  teacher         Teacher?
  student         Student?
  parent          Parent?
  accountant      Accountant?
  librarian       Librarian?
  principal       Principal?
  transportStaff  TransportStaff?
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id])
  customRoleId    String?
  customRole      CustomRole?      @relation(fields: [customRoleId], references: [id])
  userPermissions UserPermission[]

  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  announcements           Announcement[]           @relation("AnnouncementAuthor")
  paymentsReceived        Payment[]                @relation("PaymentsReceived")
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  borrowedBooks           BookLoan[]               @relation("BorrowedBooks")
  issuedBooks             BookLoan[]               @relation("IssuedBooks")

  staffAttendances StaffAttendance[]

  leavesApplied  Leave[] @relation("LeaveApplicant")
  leavesApproved Leave[] @relation("LeaveApprover")

  @@index([institutionId])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revoked             Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdByIp         String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String       @id @default(uuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  success       Boolean
  ip            String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([institutionId])
  @@map("audit_logs")
}

// Opaque random token (hashed before storage, same pattern as
// RefreshToken) emailed to a user requesting a password reset.
// Single-use: `used` flips true the moment it's redeemed.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Same pattern, emailed at registration to confirm the address is real.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model Admin {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("admins")
}

model Accountant {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("accountants")
}

model Librarian {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("librarians")
}

model Principal {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("principals")
}

model TransportStaff {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  vehicles Vehicle[]

  @@map("transport_staff")
}

model Vehicle {
  id            String  @id @default(uuid())
  vehicleNumber String
  type          String
  capacity      Int
  driverName    String
  route         String?
  status        String  @default("ACTIVE")

  transportStaffId String?
  transportStaff   TransportStaff? @relation(fields: [transportStaffId], references: [id])
  institutionId    String
  institution      Institution     @relation(fields: [institutionId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([institutionId, vehicleNumber])
  @@index([institutionId])
  @@index([transportStaffId])
  @@map("vehicles")
}

model Teacher {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  surname   String
  phone     String?
  address   String?
  img       String?
  bloodType String?
  sex       Sex?
  birthday  DateTime?
  createdAt DateTime  @default(now())

  subjects Subject[]
  lessons  Lesson[]
  classes  Class[]   @relation("ClassSupervisor")

  teacherAttendances TeacherAttendance[]

  @@index([name(ops: raw("gin_trgm_ops")), surname(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("teachers")
}

model Student {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  surname   String
  roll      Int?
  phone     String?
  address   String?
  img       String?
  bloodType String?
  sex       Sex?
  birthday  DateTime?
  status    StudentStatus @default(ACTIVE)
  admissionNumber       String?
  registrationNumber    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt DateTime  @default(now())

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id])

  attendances  Attendance[]
  results      Result[]
  invoices     Invoice[]
  scholarships Scholarship[]

  @@index([name(ops: raw("gin_trgm_ops")), surname(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([parentId])
  @@index([classId])
  @@index([gradeId])
   @@index([status])
  @@map("students")
}

model Parent {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  surname   String
  phone     String?
  address   String?
  occupation String?
  relation   GuardianRelation?
  createdAt DateTime @default(now())

  students Student[]

  @@map("parents")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Grade {
  id    String         @id @default(uuid())
  level Int
  name  String?
  stage EducationLevel @default(SCHOOL)

  students      Student[]
  classes       Class[]
  feeStructures FeeStructure[]
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, level])
  @@index([institutionId])
  @@map("grades")
}

model Class {
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  id           String      @id @default(uuid())
  name         String
  capacity     Int

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id])

  supervisorId String?
  supervisor   Teacher? @relation("ClassSupervisor", fields: [supervisorId], references: [id])

  students      Student[]
  lessons       Lesson[]
  events        Event[]
  announcements Announcement[]
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([gradeId])
  @@index([supervisorId])
  @@index([departmentId])
  @@map("classes")
}

model Subject {
  id   String @id @default(uuid())
  name String

  teachers      Teacher[]
  lessons       Lesson[]
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("subjects")
}

model Lesson {
  id        String   @id @default(uuid())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
  @@map("lessons")
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  fullMarks Int      @default(100)
  passMarks Int      @default(33)
  startTime DateTime
  endTime   DateTime

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  results Result[]

  @@index([lessonId])
  @@map("exams")
}

model Assignment {
  id        String   @id @default(uuid())
  title     String
  fullMarks Int      @default(100)
  passMarks Int      @default(33)
  startDate DateTime
  dueDate   DateTime

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  results Result[]

  @@index([lessonId])
  @@map("assignments")
}

model Result {
  id    String @id @default(uuid())
  score Int

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([examId])
  @@index([assignmentId])
  @@map("results")
}

model Attendance {
  id      String   @id @default(uuid())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([date])
  @@map("attendances")
}

// Teachers' own daily attendance (separate from the student Attendance
// model above). One row per teacher per day.
model TeacherAttendance {
  id        String             @id @default(uuid())
  date      DateTime
  status    HrAttendanceStatus
  checkIn   DateTime?
  checkOut  DateTime?
  remarks   String?
  createdAt DateTime           @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@map("teacher_attendances")
}

// Covers all non-teaching staff (Accountant, Librarian, Principal, and
// any future staff role) uniformly by keying off User instead of a
// specific role table — avoids a schema change every time a new staff
// role is introduced.
model StaffAttendance {
  id        String             @id @default(uuid())
  date      DateTime
  status    HrAttendanceStatus
  checkIn   DateTime?
  checkOut  DateTime?
  remarks   String?
  createdAt DateTime           @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("staff_attendances")
}

// Leave requests for anyone with a User account (teacher, staff,
// student, parent). Approver is whoever actioned it (typically Admin
// or Principal).
model Leave {
  id        String      @id @default(uuid())
  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  remarks   String?
  appliedAt DateTime    @default(now())
  decidedAt DateTime?

  applicantId String
  applicant   User   @relation("LeaveApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?   @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([applicantId])
  @@index([status])
  @@map("leaves")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId       String?
  class         Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@index([classId])
  @@map("events")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime @default(now())

  classId       String?
  class         Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  authorId      String?
  author        User?       @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([institutionId])
  @@index([classId])
  @@index([authorId])
  @@map("announcements")
}

model Message {
  id      String   @id @default(uuid())
  content String
  sentAt  DateTime @default(now())
  read    Boolean  @default(false)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId, read])
  @@map("messages")
}

model Book {
  id              String   @id @default(uuid())
  title           String
  author          String
  isbn            String
  category        String?
  coverImage      String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans         BookLoan[]
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, isbn])
  @@index([institutionId])
  @@map("books")
}

model BookLoan {
  id         String     @id @default(uuid())
  status     LoanStatus @default(BORROWED)
  borrowedAt DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Float?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  borrowerId String
  borrower   User   @relation("BorrowedBooks", fields: [borrowerId], references: [id])

  issuedById String
  issuedBy   User   @relation("IssuedBooks", fields: [issuedById], references: [id])

  @@index([bookId])
  @@index([borrowerId])
  @@index([status])
  @@map("book_loans")
}

model FeeStructure {
  id        String       @id @default(uuid())
  name      String
  amount    Float
  frequency FeeFrequency @default(TERM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id])

  invoices      Invoice[]
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([name, gradeId])
  @@index([institutionId])
  @@index([gradeId])
  @@map("fee_structures")
}

model Invoice {
  id             String        @id @default(uuid())
  period         String // e.g. "September 2026" or "Term 1 2026"
  amount         Float
  amountPaid     Float         @default(0)
  discountAmount Float         @default(0)
  discountReason String?
  fineAmount     Float         @default(0)
  fineReason     String?
  dueDate        DateTime
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])

  payments Payment[]

  @@index([studentId, status])
  @@index([feeStructureId])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(uuid())
  amount    Float
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  receivedById String
  receivedBy   User   @relation("PaymentsReceived", fields: [receivedById], references: [id])

  @@index([invoiceId])
  @@index([receivedById])
  @@map("payments")
}

model Scholarship {
  id        String       @id @default(uuid())
  name      String
  type      DiscountType
  value     Float // PERCENTAGE হলে 0-100, FIXED হলে সরাসরি amount
  active    Boolean      @default(true)
  startDate DateTime     @default(now())
  endDate   DateTime?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("scholarships")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "student:create"
  module      String // e.g. "student"
  action      String // e.g. "create"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions CustomRolePermission[]
  userPermissions UserPermission[]

  @@index([module])
  @@map("permissions")
}

model CustomRole {
  id          String   @id @default(uuid())
   name        String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  description String?
  isSystem    Boolean  @default(false)
  baseRole    Role?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions CustomRolePermission[]
  users       User[]

   @@unique([institutionId, name])
  @@index([institutionId])
  @@map("custom_roles")
}

model CustomRolePermission {
  id           String     @id @default(uuid())
  customRoleId String
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, permissionId])
  @@map("custom_role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true) // true = extra grant, false = explicit revoke override

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  SCHOOL_AND_COLLEGE
  MADRASA
  OTHER
}

enum InstitutionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Institution {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  type            InstitutionType   @default(SCHOOL)
  status          InstitutionStatus @default(ACTIVE)
  eiin            String?
  logo            String?
  phone           String?
  email           String?
  address         String?
  website         String?
  establishedYear Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  users         User[]
  grades        Grade[]
  classes       Class[]
  subjects      Subject[]
  books         Book[]
  feeStructures FeeStructure[]
  vehicles      Vehicle[]
  events        Event[]
  announcements Announcement[]
  auditLogs     AuditLog[]
  academicYears AcademicYear[]
   departments   Department[]
  customRoles   CustomRole[]

  @@map("institutions")
}

enum EducationLevel {
  SCHOOL
  COLLEGE
}

enum DepartmentType {
  GROUP
  DEPARTMENT
}

enum TermType {
  TERM
  SEMESTER
  TRIMESTER
}

// Science / Humanities / Business Studies (school groups) or
// CSE / Physics / English (college departments).
model Department {
  id            String         @id @default(uuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])
  name          String
  code          String?
  type          DepartmentType @default(DEPARTMENT)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  classes Class[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("departments")
}

model AcademicYear {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String // e.g. "2026" or "2026-2027"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  terms Term[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("academic_years")
}

// Term / Semester / Trimester inside an academic year.
model Term {
  id             String       @id @default(uuid())
  name           String // e.g. "1st Semester"
  type           TermType     @default(TERM)
  startDate      DateTime
  endDate        DateTime
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@map("terms")
}