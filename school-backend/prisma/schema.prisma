generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  PRINCIPAL
}

enum Sex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}
enum LoanStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
}

enum FeeFrequency {
  MONTHLY
  TERM
  YEARLY
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_BANKING
}

enum HrAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  ON_LEAVE
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Base auth/user record. Each role has a linked profile table for
// role-specific fields, keeping the auth table lean.
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
   phone     String?  @unique
  password  String
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin      Admin?
  teacher    Teacher?
  student    Student?
  parent     Parent?
  accountant Accountant?
  librarian  Librarian?
  principal  Principal?

   sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  announcements    Announcement[] @relation("AnnouncementAuthor")
    paymentsReceived Payment[] @relation("PaymentsReceived")
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
    borrowedBooks BookLoan[] @relation("BorrowedBooks")
  issuedBooks   BookLoan[] @relation("IssuedBooks")

  staffAttendances StaffAttendance[]

  leavesApplied  Leave[] @relation("LeaveApplicant")
  leavesApproved Leave[] @relation("LeaveApprover")

  @@map("users")
}
model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revoked             Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdByIp         String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  success   Boolean
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
@@map("audit_logs")
}

// Opaque random token (hashed before storage, same pattern as
// RefreshToken) emailed to a user requesting a password reset.
// Single-use: `used` flips true the moment it's redeemed.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Same pattern, emailed at registration to confirm the address is real.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  surname String

  @@map("admins")
}
model Accountant {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("accountants")
}

model Librarian {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("librarians")
}

model Principal {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  surname String

  @@map("principals")
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  surname   String
  phone     String?
  address   String?
  img       String?
  bloodType String?
  sex       Sex?
  birthday  DateTime?
  createdAt DateTime @default(now())

  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]    @relation("ClassSupervisor")

  teacherAttendances TeacherAttendance[]

  @@index([name(ops: raw("gin_trgm_ops")), surname(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("teachers")
}

model Student {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  surname   String
  roll      Int?
  phone     String?
  address   String?
  img       String?
  bloodType String?
  sex       Sex?
  birthday  DateTime?
  createdAt DateTime  @default(now())

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id])

  attendances Attendance[]
  results     Result[]
  invoices Invoice[]

  @@index([name(ops: raw("gin_trgm_ops")), surname(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("students")
}

model Parent {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  surname   String
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  students Student[]

  @@map("parents")
}

model Grade {
  id    String @id @default(uuid())
  level Int    @unique

  students Student[]
  classes  Class[]
  feeStructures FeeStructure[]

  @@map("grades")
}

model Class {
  id       String @id @default(uuid())
  name     String @unique
  capacity Int

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id])

  supervisorId String?
  supervisor   Teacher? @relation("ClassSupervisor", fields: [supervisorId], references: [id])

  students      Student[]
  lessons       Lesson[]
  events        Event[]
  announcements Announcement[]

  @@map("classes")
}

model Subject {
  id   String @id @default(uuid())
  name String @unique

  teachers Teacher[]
  lessons  Lesson[]

  @@map("subjects")
}

model Lesson {
  id        String   @id @default(uuid())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]

  @@map("lessons")
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  fullMarks Int @default(100)
  passMarks Int @default(33)
  startTime DateTime
  endTime   DateTime

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  results Result[]

  @@map("exams")
}

model Assignment {
  id       String   @id @default(uuid())
  title    String
    fullMarks Int @default(100)
  passMarks Int @default(33)
  startDate DateTime
  dueDate   DateTime

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  results Result[]

  @@map("assignments")
}

model Result {
  id    String @id @default(uuid())
  score Int

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("results")
}

model Attendance {
  id      String   @id @default(uuid())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

// Teachers' own daily attendance (separate from the student Attendance
// model above). One row per teacher per day.
model TeacherAttendance {
  id        String             @id @default(uuid())
  date      DateTime
  status    HrAttendanceStatus
  checkIn   DateTime?
  checkOut  DateTime?
  remarks   String?
  createdAt DateTime           @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@map("teacher_attendances")
}

// Covers all non-teaching staff (Accountant, Librarian, Principal, and
// any future staff role) uniformly by keying off User instead of a
// specific role table — avoids a schema change every time a new staff
// role is introduced.
model StaffAttendance {
  id        String             @id @default(uuid())
  date      DateTime
  status    HrAttendanceStatus
  checkIn   DateTime?
  checkOut  DateTime?
  remarks   String?
  createdAt DateTime           @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("staff_attendances")
}

// Leave requests for anyone with a User account (teacher, staff,
// student, parent). Approver is whoever actioned it (typically Admin
// or Principal).
model Leave {
  id        String      @id @default(uuid())
  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  remarks   String?
  appliedAt DateTime    @default(now())
  decidedAt DateTime?

  applicantId String
  applicant   User   @relation("LeaveApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?   @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@map("leaves")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime @default(now())

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@map("announcements")
}

model Message {
  id      String   @id @default(uuid())
  content String
  sentAt  DateTime @default(now())
  read    Boolean  @default(false)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@map("messages")
}


model Book {
  id              String   @id @default(uuid())
  title           String
  author          String
  isbn            String   @unique
  category        String?
  coverImage      String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans BookLoan[]

  @@map("books")
}

model BookLoan {
  id         String     @id @default(uuid())
  status     LoanStatus @default(BORROWED)
  borrowedAt DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Float?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  borrowerId String
  borrower   User   @relation("BorrowedBooks", fields: [borrowerId], references: [id])

  issuedById String
  issuedBy   User   @relation("IssuedBooks", fields: [issuedById], references: [id])

  @@map("book_loans")
}
model FeeStructure {
  id        String       @id @default(uuid())
  name      String
  amount    Float
  frequency FeeFrequency @default(TERM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id])

  invoices Invoice[]

  @@unique([name, gradeId])
  @@map("fee_structures")
}

model Invoice {
  id         String        @id @default(uuid())
  period     String        // e.g. "September 2026" or "Term 1 2026"
  amount     Float
  amountPaid Float         @default(0)
  dueDate    DateTime
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])

  payments Payment[]

  @@index([studentId, status])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(uuid())
  amount    Float
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  receivedById String
  receivedBy   User   @relation("PaymentsReceived", fields: [receivedById], references: [id])

  @@map("payments")
}